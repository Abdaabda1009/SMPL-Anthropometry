# Measurement Engine API — environment configuration.
# Copy to `.env` and fill in real values (`.env` itself is gitignored, this
# example file is the only one tracked). Full docs for each variable:
# measurement_engine/config.py (and measure.py for SMPL_MODEL_CACHE).

# --- security ---
# If set, /measure/* requires header `X-API-Key: <value>`. Leave blank to
# run with no auth (e.g. local development).
API_KEY=

# --- capacity ---
# Concurrent fits this process will run; each needs ~2 GB RAM.
MAX_WORKERS=2

# Mesh upload size limit, in MB.
MAX_UPLOAD_MB=200

# Distinct (mesh, model_type, gender) fit results kept in the result cache
# (measurement_engine/fit_cache.py). A repeat upload of an already-cached
# mesh skips the fit entirely instead of re-running it.
FIT_CACHE_SIZE=256

# Body-model cache slots (measure.py). 3 covers all genders of one model
# type; raise this if you serve both smpl and smplx from one process.
SMPL_MODEL_CACHE=3

# torch device for model loading + /measure/shape ("cpu", "cuda", "cuda:0").
# Leave blank to auto-detect (cuda if available, else cpu). Does NOT affect
# fit_mesh.py's fit() loop behind /measure/mesh, which is CPU-only for now —
# see that file's build_model() docstring for why, and what's left to do.
TORCH_DEVICE=

# --- lifecycle ---
# Finished job records are evicted after this many seconds.
JOB_TTL_SECONDS=86400

# Comma-separated genders to load at startup instead of on first use, e.g.
# "MALE,FEMALE". Leave blank to load lazily (first request per gender pays
# the model-load cost).
PRELOAD_GENDERS="MALE,FEMALE"

# --- run_api.sh only (not read by the app itself; uvicorn/shell defaults) ---
PYTHON=python
HOST=0.0.0.0
PORT=8100
